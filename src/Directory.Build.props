<Project>
  <!-- Runs SonarCloud's C# rules during build so issues surface locally before they reach a PR.
       Rule severities are tuned in .editorconfig. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>
</Project>
